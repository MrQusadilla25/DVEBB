{
    "name": "stoker/membershipyears",
    "type": "phpbb-extension",
    "description": "Adds how many years users have been registered",
    "homepage": "https://phpbb3bbcodes.com",
    "version": "1.0.1",
    "time": "2026-01-19",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Stoker",
            "homepage": "https://phpbb3bbcodes.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "phpbb/phpbb": ">=3.3.0",
        "composer/installers": "~1.0 || ~2.0"
    },
    "extra": {
        "display-name": "Membership Years",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/membership_years",
            "filename": "version_check",
            "ssl": true
        }
    }
}
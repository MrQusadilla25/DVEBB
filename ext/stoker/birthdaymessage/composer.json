{
    "name": "stoker/birthdaymessage",
    "type": "phpbb-extension",
    "description": "Displays a birthday message to users on their birthday",
    "homepage": "https://www.phpbb3bbcodes.com",
    "version": "1.0.2",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Stoker",
            "homepage": "https://phpbb3bbcodes.com/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "~1.0||~2.0",
        "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
    },
    "extra": {
        "display-name": "Birthday Message",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/birthday_message",
            "filename": "version_check",
            "ssl": true
        }
    }
}